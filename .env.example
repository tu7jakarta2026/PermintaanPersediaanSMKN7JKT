# Google Apps Script Web App deployment URL (/exec)
GAS_URL=https://script.google.com/macros/s/PASTE_DEPLOYMENT_ID/exec

# Nilai yang muncul di Execution Log setelah menjalankan setupAuthSystem() di Apps Script
GAS_BACKEND_SECRET=PASTE_SECRET_FROM_APPS_SCRIPT

# Minimal 32 karakter acak. Gunakan perintah PowerShell pada README_AUTH.md
SESSION_SECRET=PASTE_RANDOM_SESSION_SECRET

# Opsional: URL CSV master barang
ITEMS_CSV_URL=
